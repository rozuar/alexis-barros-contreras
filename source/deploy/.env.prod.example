# Copia este archivo a ../.env.prod (junto a docker-compose.prod.yml) y rellena los valores.
# NO lo subas a git (ya está cubierto por .gitignore: .env.*).

# --- Base de datos (Postgres corre dentro del compose) ---
POSTGRES_DB=alexis_art
POSTGRES_USER=alexis
# Genera una contraseña fuerte, ej: openssl rand -base64 24
POSTGRES_PASSWORD=CAMBIA_ESTO

# --- Backend ---
# Token de admin del backend. Genera uno largo: openssl rand -hex 32
ADMIN_TOKEN=CAMBIA_ESTO

# --- Caddy / SSL ---
# Email para los certificados Let's Encrypt (recibe avisos de expiración).
ACME_EMAIL=tucorreo@ejemplo.cl

# --- (Opcional) DigitalOcean Spaces en vez de disco ---
# Si defines estas, el backend usa Spaces en lugar del volumen local.
# BUCKET_NAME=
# BUCKET_REGION=
# BUCKET_ENDPOINT=
# BUCKET_ACCESS_KEY_ID=
# BUCKET_SECRET_ACCESS_KEY=
